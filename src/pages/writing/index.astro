---
import Layout from "@/layouts/Layout.astro";

interface PostMeta  { title: string; date?: string; tag: string; description: string; }
interface DebugMeta { label: string; title: string; description: string; tags: string[]; href?: string; }
interface PostModule { metadata?: PostMeta | DebugMeta; }

function toHref(path: string) {
  return '/writing' + path.replace(/^\.\//, '/').replace(/\/index\.(astro|mdx)$/, '/');
}

function isDebug(m: PostMeta | DebugMeta): m is DebugMeta {
  return 'tags' in m && Array.isArray((m as DebugMeta).tags);
}

const allModules = {
  ...import.meta.glob<PostModule>('./*/index.astro', { eager: true }),
  ...import.meta.glob<PostModule>('./*/index.mdx',   { eager: true }),
};

const entries = Object.entries(allModules)
  .filter(([, m]) => m.metadata)
  .map(([path, m]) => {
    const meta = m.metadata!;
    if (isDebug(meta)) {
      return { href: meta.href ?? toHref(path), title: meta.title, date: undefined, tag: meta.tags[0] ?? 'debugging', description: meta.description };
    }
    return { href: toHref(path), title: meta.title, date: meta.date, tag: meta.tag, description: meta.description };
  })
  .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));

const tags = ['all', ...Array.from(new Set(entries.map(e => e.tag))).sort()];
---

<Layout title="Writing — Vinicius Cerutti" description="Technical notes, research, and debugging references.">
  <div class="writing-shell">

    <header class="writing-header">
      <h1 class="page-title">Writing.</h1>
      <p class="page-sub">Technical notes, research, and debugging references. Kubernetes, platform engineering, numerical methods, and whatever else needed writing down.</p>
    </header>

    <div class="writing-layout">

      <aside class="tag-sidebar" aria-label="Filter by tag">
        <p class="sidebar-label">topics</p>
        <nav class="tag-list">
          {tags.map(t => (
            <button class:list={["tag-btn", t === 'all' && 'active']} data-tag={t === 'all' ? '' : t}>
              {t}
              {t === 'all'
                ? <span class="tag-count">{entries.length}</span>
                : <span class="tag-count">{entries.filter(e => e.tag === t).length}</span>
              }
            </button>
          ))}
        </nav>
      </aside>

      <section aria-label="Posts">
        {entries.length === 0 ? (
          <p class="text-muted-foreground text-sm">Nothing published yet.</p>
        ) : (
          <div class="posts-grid" id="posts-grid">
            {entries.map(({ href, date, tag, title, description }) => (
              <a href={href} class="index-card" data-tag={tag}>
                <div class="meta-label">{date ? `${date} · ` : ''}{tag}</div>
                <h2 class="index-title">{title}</h2>
                <p class="card-desc">{description}</p>
              </a>
            ))}
          </div>
        )}
      </section>

    </div>
  </div>
</Layout>

<script>
  const btns  = document.querySelectorAll<HTMLButtonElement>('.tag-btn');
  const cards = document.querySelectorAll<HTMLElement>('.index-card');

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      btns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const tag = btn.dataset.tag ?? '';
      cards.forEach(card => {
        card.style.display = (!tag || card.dataset.tag === tag) ? '' : 'none';
      });
    });
  });
</script>

<style>
  .writing-shell {
    width: min(1120px, calc(100% - 44px));
    margin: 0 auto;
  }

  .writing-header {
    padding: clamp(64px, 8vw, 108px) 0 clamp(40px, 5vw, 56px);
    border-bottom: 1px solid var(--border);
    max-width: 820px;
  }
  .page-title {
    font-size: clamp(48px, 7vw, 84px);
    font-weight: 700;
    letter-spacing: -0.065em;
    line-height: 0.96;
    margin: 0 0 20px;
    color: var(--foreground);
  }
  .page-sub {
    font-size: 19px;
    color: var(--muted-foreground);
    line-height: 1.55;
    margin: 0;
    max-width: 680px;
  }

  .writing-layout {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: clamp(32px, 4vw, 56px);
    padding: clamp(36px, 4vw, 52px) 0;
    align-items: start;
  }

  /* Sidebar */
  .tag-sidebar {
    position: sticky;
    top: 86px;
  }
  .sidebar-label {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--faint);
    margin: 0 0 14px;
  }
  .tag-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tag-btn {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    width: 100%;
    text-align: left;
    padding: 6px 10px;
    border-radius: 6px;
    border: none;
    background: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted-foreground);
    transition: color 140ms, background 140ms;
  }
  .tag-btn:hover { color: var(--foreground); background: rgba(255,255,255,0.04); }
  .tag-btn.active { color: var(--accent); background: rgba(94,234,212,0.07); }
  .tag-count {
    font-size: 10px;
    color: var(--faint);
    min-width: 14px;
    text-align: right;
  }
  .tag-btn.active .tag-count { color: var(--accent); opacity: 0.7; }

  /* Posts grid */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .meta-label {
    color: var(--faint);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .index-card {
    display: flex;
    flex-direction: column;
    padding: 26px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgba(18,21,27,0.78);
    transition: border-color 160ms, background 160ms;
    text-decoration: none;
    gap: 10px;
  }
  .index-card:hover { border-color: var(--border-strong); background: var(--surface-raised); }
  .index-title {
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--foreground);
    margin: 0;
  }
  .card-desc {
    font-size: 14px;
    color: var(--muted-foreground);
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 860px) {
    .writing-layout { grid-template-columns: 1fr; }
    .tag-sidebar { position: static; display: flex; flex-direction: column; }
    .tag-list { flex-direction: row; flex-wrap: wrap; gap: 6px; }
    .tag-btn { width: auto; }
  }
  @media (max-width: 600px) {
    .posts-grid { grid-template-columns: 1fr; }
  }
</style>
