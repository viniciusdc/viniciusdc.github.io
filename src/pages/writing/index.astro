---
import Layout from "@/layouts/Layout.astro";
import PageRule from "@/components/ui/PageRule.astro";

interface PostMeta  { title: string; date?: string; tag: string; description: string; }
interface DebugMeta { label: string; title: string; description: string; tags: string[]; href?: string; }
interface PostModule { metadata?: PostMeta | DebugMeta; }

function toHref(path: string) {
  return '/writing' + path.replace(/^\.\//, '/').replace(/\/index\.(astro|mdx)$/, '/');
}

function isDebug(m: PostMeta | DebugMeta): m is DebugMeta {
  return 'tags' in m && Array.isArray((m as DebugMeta).tags);
}

const allModules = {
  ...import.meta.glob<PostModule>('./*/index.astro', { eager: true }),
  ...import.meta.glob<PostModule>('./*/index.mdx',   { eager: true }),
};

const entries = Object.entries(allModules)
  .filter(([, m]) => m.metadata)
  .map(([path, m]) => {
    const meta = m.metadata!;
    if (isDebug(meta)) {
      return { href: meta.href ?? toHref(path), title: meta.title, date: undefined, tag: meta.tags[0] ?? 'debugging', description: meta.description };
    }
    return { href: toHref(path), title: meta.title, date: meta.date, tag: meta.tag, description: meta.description };
  })
  .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));

const tags = ['all', ...Array.from(new Set(entries.map(e => e.tag))).sort()];
---

<Layout title="Writing — Vinicius's notebook" description="Notes, essays, and references. Software, AI, math, design, and whatever else has my attention.">
  <div class="w-[min(880px,calc(100%-44px))] mx-auto">
    <main>

      <header class="page-head">
        <p class="page-meta">writing</p>
        <h1 class="page-title">Things I've written down.</h1>
        <p class="page-sub">
          Notes, essays, references. Some technical, some not.
          Organized loosely by topic; filter below if you're looking for something specific.
        </p>
      </header>

      <PageRule />

      {entries.length === 0 ? (
        <p class="empty-line">Nothing on the shelves yet — the notebook is still being set up.</p>
      ) : (
        <div class="writing-layout">

          <aside class="tag-sidebar" aria-label="Filter by tag">
            <p class="sidebar-label">topics</p>
            <nav class="tag-list">
              {tags.map(t => (
                <button class:list={["tag-btn", t === 'all' && 'active']} data-tag={t === 'all' ? '' : t}>
                  <span>{t}</span>
                  <span class="tag-count">
                    {t === 'all' ? entries.length : entries.filter(e => e.tag === t).length}
                  </span>
                </button>
              ))}
            </nav>
          </aside>

          <section aria-label="Posts">
            <ol class="entry-list" id="posts-grid">
              {entries.map(({ href, date, tag, title, description }) => (
                <li class="entry" data-tag={tag}>
                  <a href={href} class="entry-link">
                    <p class="entry-meta">{date ? `${date} · ` : ''}{tag}</p>
                    <h2 class="entry-title">{title}</h2>
                    <p class="entry-desc">{description}</p>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        </div>
      )}

    </main>
  </div>
</Layout>

<script>
  const btns    = document.querySelectorAll<HTMLButtonElement>('.tag-btn');
  const entries = document.querySelectorAll<HTMLElement>('.entry');

  btns.forEach(btn => {
    btn.addEventListener('click', () => {
      btns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const tag = btn.dataset.tag ?? '';
      entries.forEach(entry => {
        entry.style.display = (!tag || entry.dataset.tag === tag) ? '' : 'none';
      });
    });
  });
</script>

<style>
  .page-head {
    padding: clamp(72px, 9vw, 120px) 0 clamp(32px, 4vw, 48px);
    max-width: 640px;
  }
  .page-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin: 0 0 22px;
  }
  .page-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(32px, 4.2vw, 46px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--foreground);
    margin: 0 0 22px;
  }
  .page-sub {
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted-foreground);
    margin: 0;
    max-width: 60ch;
  }

  .empty-line {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 17px;
    color: var(--muted-foreground);
    padding: 0 0 clamp(64px, 8vw, 100px);
  }

  .writing-layout {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: clamp(28px, 4vw, 48px);
    padding: 0 0 clamp(64px, 8vw, 96px);
    align-items: start;
  }

  /* Sidebar */
  .tag-sidebar {
    position: sticky;
    top: 86px;
  }
  .sidebar-label {
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--faint);
    margin: 0 0 14px;
  }
  .tag-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tag-btn {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    width: 100%;
    text-align: left;
    padding: 6px 10px;
    border-radius: 6px;
    border: none;
    background: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted-foreground);
    transition: color 140ms, background 140ms;
  }
  .tag-btn:hover { color: var(--foreground); background: rgba(212, 162, 97, 0.04); }
  .tag-btn.active { color: var(--accent); background: rgba(212, 162, 97, 0.07); }
  .tag-count {
    font-size: 10px;
    color: var(--faint);
    min-width: 14px;
    text-align: right;
  }
  .tag-btn.active .tag-count { color: var(--accent); opacity: 0.7; }

  /* Entry list — same pattern as the homepage. */
  .entry-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .entry { margin: 0; }
  .entry-link {
    display: block;
    padding: 16px 14px;
    margin: 0 -14px;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: background 180ms ease, transform 180ms ease;
  }
  .entry-link:hover {
    background: rgba(212, 162, 97, 0.04);
    transform: translateX(2px);
  }
  .entry-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 4px;
  }
  .entry-title {
    font-family: var(--font-sans);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--foreground);
    margin: 0 0 4px;
  }
  .entry-desc {
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted-foreground);
    margin: 0;
  }

  @media (max-width: 720px) {
    .writing-layout { grid-template-columns: 1fr; }
    .tag-sidebar { position: static; }
    .tag-list { flex-direction: row; flex-wrap: wrap; gap: 6px; }
    .tag-btn { width: auto; }
  }
</style>
