---
import Layout from "@/layouts/Layout.astro";

interface PostMeta {
  title: string;
  date?: string;
  tag: string;
  description: string;
}
interface PostModule { metadata?: PostMeta; }

function toHref(base: string, path: string) {
  return base + path.replace(/^\.\//, '/').replace(/\/index\.(astro|mdx)$/, '/');
}

const astroModules = import.meta.glob<PostModule>('./*/index.astro', { eager: true });
const mdxModules  = import.meta.glob<PostModule>('./*/index.mdx',   { eager: true });

const essays = [...Object.entries(astroModules), ...Object.entries(mdxModules)]
  .filter(([, m]) => m.metadata)
  .map(([path, m]) => ({ href: toHref('/architecture', path), ...m.metadata! }))
  .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''));
---

<Layout title="Architecture — Vinicius Cerutti" description="Long-form design notes about system boundaries, tradeoffs, and platform direction.">
  <div class="w-[min(1120px,calc(100%-44px))] mx-auto">
    <main>
      <header class="page-header">
        <h1 class="page-title">Architecture notes for systems that need to keep working.</h1>
        <p class="page-sub">Long-form essays about boundaries, tradeoffs, platform direction, and why the system should be shaped this way.</p>
      </header>

      <section class="py-[clamp(36px,4vw,52px)]">
        {essays.length === 0 ? (
          <p class="text-muted-foreground text-sm">No essays published yet.</p>
        ) : (
          <div class="grid grid-cols-2 gap-3.5">
            {essays.map(({ href, tag, title, description }) => (
              <a href={href} class="index-card">
                <div class="card-tag">{tag}</div>
                <h2 class="card-title">{title}</h2>
                <p class="card-desc">{description}</p>
              </a>
            ))}
          </div>
        )}
      </section>
    </main>
  </div>
</Layout>

<style>
  .page-header {
    padding: clamp(64px, 8vw, 108px) 0 clamp(40px, 5vw, 60px);
    border-bottom: 1px solid var(--border);
    max-width: 820px;
  }
  .page-title {
    font-size: clamp(42px, 6vw, 76px);
    font-weight: 700;
    letter-spacing: -0.065em;
    line-height: 0.97;
    margin: 0 0 20px;
    color: var(--foreground);
  }
  .page-sub {
    font-size: 19px;
    color: var(--muted-foreground);
    line-height: 1.55;
    margin: 0;
    max-width: 680px;
  }
  .card-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--faint);
    margin-bottom: 14px;
  }
  .card-title {
    font-size: clamp(22px, 2.5vw, 28px);
    font-weight: 650;
    line-height: 1.15;
    letter-spacing: -0.035em;
    color: var(--foreground);
    margin: 0 0 10px;
  }
  .card-desc {
    font-size: 15px;
    color: var(--muted-foreground);
    line-height: 1.6;
    margin: 0;
  }
  .index-card {
    padding: 26px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: rgba(18,21,27,0.78);
    transition: border-color 160ms, background 160ms;
    text-decoration: none;
    display: block;
  }
  .index-card:hover { border-color: var(--border-strong); background: var(--surface-raised); }
  @media (max-width: 780px) {
    .grid { grid-template-columns: 1fr !important; }
  }
</style>
