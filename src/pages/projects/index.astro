---
import Layout from "@/layouts/Layout.astro";
import Badge from "@/components/ui/Badge.astro";
import PageRule from "@/components/ui/PageRule.astro";

interface ProjectMeta {
  label: string;
  title: string;
  description: string;
  tags: string[];
}
interface ProjectModule { metadata?: ProjectMeta; }

function toHref(path: string) {
  return '/projects' + path.replace(/^\.\//, '/').replace(/\/index\.(astro|mdx)$/, '/');
}

const modules = import.meta.glob<ProjectModule>('./*/index.astro', { eager: true });

const projects = Object.entries(modules)
  .filter(([, m]) => m.metadata)
  .map(([path, m]) => ({ href: toHref(path), ...m.metadata! }));
---

<Layout title="Projects — Vinicius's notebook" description="Systems, tools, and platform work — written up as engineering notes rather than portfolio cards.">
  <div class="w-[min(880px,calc(100%-44px))] mx-auto">
    <main>

      <header class="page-head">
        <p class="page-meta">projects</p>
        <h1 class="page-title">Systems, tools, and platform work.</h1>
        <p class="page-sub">
          Written up as engineering notes rather than portfolio cards.
          Each one is a thing I built or worked on long enough to have opinions about.
        </p>
      </header>

      <PageRule />

      {projects.length === 0 ? (
        <p class="empty-line">Nothing here yet — projects still being moved into the notebook.</p>
      ) : (
        <ol class="entry-list">
          {projects.map(({ href, label, title, description, tags }) => (
            <li class="entry">
              <a href={href} class="entry-link">
                <p class="entry-meta">{label}</p>
                <h2 class="entry-title">{title}</h2>
                <p class="entry-desc">{description}</p>
                {tags?.length > 0 && (
                  <div class="entry-tags">
                    {tags.map(t => <Badge variant="outline">{t}</Badge>)}
                  </div>
                )}
              </a>
            </li>
          ))}
        </ol>
      )}

    </main>
  </div>
</Layout>

<style>
  .page-head {
    padding: clamp(72px, 9vw, 120px) 0 clamp(32px, 4vw, 48px);
    max-width: 640px;
  }
  .page-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin: 0 0 22px;
  }
  .page-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(32px, 4.2vw, 46px);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--foreground);
    margin: 0 0 22px;
  }
  .page-sub {
    font-family: var(--font-serif);
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted-foreground);
    margin: 0;
    max-width: 60ch;
  }

  .empty-line {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 17px;
    color: var(--muted-foreground);
    padding: 0 0 clamp(64px, 8vw, 100px);
  }

  .entry-list {
    list-style: none;
    padding: 0 0 clamp(64px, 8vw, 96px);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .entry { margin: 0; }
  .entry-link {
    display: block;
    padding: 22px 18px;
    margin: 0 -18px;
    border-radius: 10px;
    text-decoration: none;
    color: inherit;
    transition: background 180ms ease, transform 180ms ease;
  }
  .entry-link:hover {
    background: rgba(212, 162, 97, 0.04);
    transform: translateX(2px);
  }
  .entry-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 0 0 8px;
  }
  .entry-title {
    font-family: var(--font-sans);
    font-size: clamp(20px, 2.4vw, 24px);
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--foreground);
    margin: 0 0 8px;
  }
  .entry-desc {
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.6;
    color: var(--muted-foreground);
    margin: 0 0 14px;
    max-width: 60ch;
  }
  .entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
</style>
