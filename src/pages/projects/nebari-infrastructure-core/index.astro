---
import Layout from "@/layouts/Layout.astro";
import { Badge } from "@/components/ui/badge";
---

<Layout title="Nebari Infrastructure Core — Vinicius Cerutti">
  <div class="w-[min(1120px,calc(100%-44px))] mx-auto">
    <main>
      <header class="page-header">
        <div class="kicker">platform</div>
        <h1 class="page-title">Nebari Infrastructure Core</h1>
        <p class="page-sub">A Go-first infrastructure direction for managing cloud resources and platform services with declarative workflows.</p>
      </header>

      <section class="project-layout py-[clamp(48px,6vw,72px)]">
        <div class="project-main">
          <h2>Intent</h2>
          <p>
            Nebari Infrastructure Core is framed as a platform control surface: a tool that can reason about cloud resources,
            platform services, and deployment workflows without forcing every operation through ad-hoc scripts.
          </p>

          <h2>Design direction</h2>
          <p>
            The project direction favors native Go, explicit resource modeling, and clear boundaries between infrastructure creation,
            platform service deployment, and GitOps synchronization.
          </p>

          <h2>Interesting problems</h2>
          <ul>
            <li>Representing cloud infrastructure declaratively while still using provider SDKs directly.</li>
            <li>Keeping cluster bootstrap, operator deployment, and application management understandable.</li>
            <li>Designing CLI output for long-running operations without hiding important context.</li>
            <li>Creating a path for platform applications to be managed consistently over time.</li>
          </ul>
        </div>

        <aside class="project-side">
          <h3>stack</h3>
          <div class="flex flex-wrap gap-2 mb-6">
            {["go", "kubernetes", "cloud sdk", "gitops", "argocd"].map(t => <Badge variant="outline">{t}</Badge>)}
          </div>
          <h3>themes</h3>
          <p>Control planes, platform automation, cloud primitives, operator integration, and developer-facing CLI design.</p>
          <a href="/projects/" class="back-link">← all projects</a>
        </aside>
      </section>
    </main>
  </div>
</Layout>

<style>
  .page-header {
    padding: clamp(64px, 8vw, 108px) 0 clamp(36px, 4vw, 52px);
    border-bottom: 1px solid var(--border);
    max-width: 820px;
  }
  .kicker {
    font-family: var(--font-mono); font-size: 11px; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--accent); margin-bottom: 18px;
  }
  .page-title {
    font-size: clamp(38px, 5.5vw, 68px); font-weight: 700;
    letter-spacing: -0.065em; line-height: 0.97; margin: 0 0 18px;
    color: var(--foreground);
  }
  .page-sub { font-size: 19px; color: var(--muted-foreground); line-height: 1.55; margin: 0; }
  .project-layout {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: clamp(40px, 5vw, 64px);
  }
  .project-main h2 {
    margin: 36px 0 10px; font-size: 22px; font-weight: 650;
    letter-spacing: -0.025em; color: var(--foreground);
  }
  .project-main h2:first-child { margin-top: 0; }
  .project-main p, .project-main li { color: #c3cbd6; font-size: 16px; line-height: 1.7; }
  .project-main ul { padding-left: 1.3rem; margin: 10px 0 18px; }
  .project-main li + li { margin-top: 7px; }
  .project-side {
    border-left: 1px solid var(--border);
    padding-left: 26px;
    padding-top: 4px;
  }
  .project-side h3 {
    font-family: var(--font-mono); font-size: 12px; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--faint); margin: 0 0 12px;
  }
  .project-side h3 + h3, .project-side div + h3 { margin-top: 28px; padding-top: 28px; border-top: 1px solid var(--border); }
  .project-side p { font-size: 14px; color: var(--muted-foreground); line-height: 1.6; margin: 0 0 20px; }
  .back-link {
    font-family: var(--font-mono); font-size: 12px; color: var(--link);
    display: block; margin-top: 28px;
  }
  .back-link:hover { text-decoration: underline; }
  @media (max-width: 780px) {
    .project-layout { grid-template-columns: 1fr; }
    .project-side { border-left: none; border-top: 1px solid var(--border); padding-left: 0; padding-top: 24px; }
  }
</style>
