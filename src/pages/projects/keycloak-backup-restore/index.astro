---
import Layout from "@/layouts/Layout.astro";
import { Badge } from "@/components/ui/badge";
---

<Layout title="Keycloak backup and restore — Vinicius Cerutti">
  <div class="w-[min(1120px,calc(100%-44px))] mx-auto">
    <main>
      <header class="page-header">
        <div class="kicker">reliability</div>
        <h1 class="page-title">Keycloak backup and restore</h1>
        <p class="page-sub">State export, dependency-aware restore, planning, conflict handling, and identity platform recovery.</p>
      </header>

      <section class="project-layout py-[clamp(48px,6vw,72px)]">
        <div class="project-main">
          <h2>Intent</h2>
          <p>
            The goal is not only to export objects from Keycloak, but to recreate meaningful state in another environment safely.
            That requires understanding dependencies, conflicts, and the difference between generated IDs and semantic identity.
          </p>

          <h2>Design direction</h2>
          <p>
            The restore path should default to dry-run planning. The user should be able to see which objects will be created,
            skipped, updated, or flagged as conflicting before any mutation occurs.
          </p>

          <h2>Interesting problems</h2>
          <ul>
            <li>Topological ordering across users, groups, clients, roles, and mappings.</li>
            <li>Conflict policies that differ by object type.</li>
            <li>API boundaries between service classes, import/export connectors, and external adapters.</li>
            <li>Making restore behavior understandable enough to trust in migration scenarios.</li>
          </ul>
        </div>

        <aside class="project-side">
          <h3>stack</h3>
          <div class="flex flex-wrap gap-2 mb-6">
            {["python", "keycloak", "fastapi", "pydantic"].map(t => <Badge variant="outline">{t}</Badge>)}
          </div>
          <h3>themes</h3>
          <p>Identity state, backup/restore, dry-run planning, conflict handling, and migration safety.</p>
          <a href="/projects/" class="back-link">← all projects</a>
        </aside>
      </section>
    </main>
  </div>
</Layout>

<style>
  .page-header {
    padding: clamp(64px, 8vw, 108px) 0 clamp(36px, 4vw, 52px);
    border-bottom: 1px solid var(--border); max-width: 820px;
  }
  .kicker {
    font-family: var(--font-mono); font-size: 11px; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--accent); margin-bottom: 18px;
  }
  .page-title {
    font-size: clamp(38px, 5.5vw, 68px); font-weight: 700;
    letter-spacing: -0.065em; line-height: 0.97; margin: 0 0 18px; color: var(--foreground);
  }
  .page-sub { font-size: 19px; color: var(--muted-foreground); line-height: 1.55; margin: 0; }
  .project-layout { display: grid; grid-template-columns: 1fr 260px; gap: clamp(40px, 5vw, 64px); }
  .project-main h2 {
    margin: 36px 0 10px; font-size: 22px; font-weight: 650;
    letter-spacing: -0.025em; color: var(--foreground);
  }
  .project-main h2:first-child { margin-top: 0; }
  .project-main p, .project-main li { color: #c3cbd6; font-size: 16px; line-height: 1.7; }
  .project-main ul { padding-left: 1.3rem; margin: 10px 0 18px; }
  .project-main li + li { margin-top: 7px; }
  .project-side { border-left: 1px solid var(--border); padding-left: 26px; padding-top: 4px; }
  .project-side h3 {
    font-family: var(--font-mono); font-size: 12px; text-transform: uppercase;
    letter-spacing: 0.08em; color: var(--faint); margin: 0 0 12px;
  }
  .project-side h3 + h3, .project-side div + h3 { margin-top: 28px; padding-top: 28px; border-top: 1px solid var(--border); }
  .project-side p { font-size: 14px; color: var(--muted-foreground); line-height: 1.6; margin: 0 0 20px; }
  .back-link { font-family: var(--font-mono); font-size: 12px; color: var(--link); display: block; margin-top: 28px; }
  .back-link:hover { text-decoration: underline; }
  @media (max-width: 780px) {
    .project-layout { grid-template-columns: 1fr; }
    .project-side { border-left: none; border-top: 1px solid var(--border); padding-left: 0; padding-top: 24px; }
  }
</style>
