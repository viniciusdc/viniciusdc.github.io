---
import Layout from "@/layouts/Layout.astro";
import PageRule from "@/components/ui/PageRule.astro";
import { Content as NowContent } from "@/data/now.md";
import nowSource from "@/data/now.md?raw";

interface PostMeta {
  title: string;
  date?: string;
  tag: string;
  description: string;
}
interface PostModule { metadata?: PostMeta; }

function toHref(base: string, path: string) {
  return base + path.replace(/^\.\/[^/]+/, '').replace(/\/index\.(astro|mdx)$/, '/');
}

const writingAstro = import.meta.glob<PostModule>('./writing/*/index.astro', { eager: true });
const writingMdx   = import.meta.glob<PostModule>('./writing/*/index.mdx',   { eager: true });

const allRecent = [
  ...Object.entries({ ...writingAstro, ...writingMdx }).map(([p, m]) => ({ href: toHref('/writing', p), ...m.metadata! })),
]
  .filter(p => p.title && p.date)
  .sort((a, b) => b.date!.localeCompare(a.date!));

const hasNow = nowSource.trim().length > 0;
---

<Layout title="Vinicius's notebook" description="A notebook of whatever I'm thinking about — software, AI, math, design, the occasional game or philosophical detour.">
  <div class="w-[min(720px,calc(100%-44px))] mx-auto">
    <main>

      <header class="hero">
        <p class="dateline">May 2026 — somewhere between calls</p>

        <p class="hero-greet">This is where I keep what I'm thinking about.</p>

        <p class="hero-copy">
          It tends to be wide — Kubernetes one week, an AI paper the next,
          sometimes math or design or a game. I'd rather write a little
          badly and find out what I think than write a lot polished and
          find I had nothing to say.
        </p>

        {hasNow && (
          <aside class="hero-margin" aria-label="What I'm working on right now">
            <span class="margin-label">right now</span>
            <div class="margin-body">
              <NowContent />
            </div>
          </aside>
        )}
      </header>

      <PageRule />

      {allRecent.length > 0 ? (
        <section class="recent" aria-labelledby="recent-title">
          <h2 class="recent-label" id="recent-title">recent</h2>

          <ol class="entry-list">
            {allRecent.map(({ href, date, tag, title, description }) => (
              <li class="entry">
                <a href={href} class="entry-link">
                  <p class="entry-meta">{date} · {tag}</p>
                  <h3 class="entry-title">{title}</h3>
                  <p class="entry-desc">{description}</p>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ) : (
        <section class="empty-state" aria-label="No posts yet">
          <p class="empty-line">Nothing on the shelves yet — the notebook is still being set up.</p>
          <p class="empty-hint">Peek at <a href="/projects/">projects</a> in the meantime, or check back soon.</p>
        </section>
      )}

    </main>
  </div>
</Layout>

<style>
  /* Staggered fade-in for hero pieces — a quiet sign of life on load. */
  @keyframes rise {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .hero {
    padding: clamp(72px, 10vw, 128px) 0 clamp(20px, 3vw, 32px);
  }
  .dateline,
  .hero-greet,
  .hero-copy,
  .hero-margin {
    animation: rise 480ms ease-out backwards;
  }
  .dateline      { animation-delay: 40ms;  }
  .hero-greet    { animation-delay: 120ms; }
  .hero-copy     { animation-delay: 240ms; }
  .hero-margin   { animation-delay: 380ms; }
  @media (prefers-reduced-motion: reduce) {
    .dateline, .hero-greet, .hero-copy, .hero-margin { animation: none; }
  }

  .dateline {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
    letter-spacing: 0.04em;
    margin: 0 0 36px;
  }
  .hero-greet {
    font-family: var(--font-serif);
    font-size: clamp(28px, 3.6vw, 38px);
    font-style: italic;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--foreground);
    margin: 0 0 22px;
  }
  .hero-copy {
    font-family: var(--font-serif);
    font-size: clamp(19px, 1.6vw, 22px);
    line-height: 1.65;
    color: var(--foreground);
    max-width: 60ch;
    margin: 0 0 32px;
  }
  .hero-margin {
    display: block;
    font-family: var(--font-serif);
    font-size: 15px;
    font-style: italic;
    line-height: 1.65;
    color: var(--muted-foreground);
    border-left: 2px solid var(--accent);
    padding: 6px 0 6px 18px;
    margin: 0;
    max-width: 56ch;
    /* a slightly more visible imperfection — leans 0.7° as if scribbled */
    transform: rotate(-0.7deg);
    transform-origin: left center;
  }
  .margin-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
    font-style: normal;
    margin-bottom: 4px;
  }
  .margin-body { display: block; }
  /* Reset markdown <p> defaults so the now-content sits flush in the margin note. */
  .margin-body :global(p) {
    margin: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 15px;
    line-height: 1.65;
    color: var(--muted-foreground);
  }
  .margin-body :global(p + p) {
    margin-top: 4px;
  }

  /* Empty state — when no posts published yet. */
  .empty-state {
    padding: 4px 0 clamp(72px, 10vw, 120px);
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--muted-foreground);
    max-width: 56ch;
  }
  .empty-line {
    font-size: 18px;
    line-height: 1.6;
    margin: 0 0 10px;
    color: var(--foreground);
  }
  .empty-hint {
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
  }
  .empty-state a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  /* Recent list (when posts exist). */
  .recent {
    padding: 4px 0 clamp(64px, 8vw, 96px);
  }
  .recent-label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin: 0 0 28px;
  }
  .entry-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .entry { margin: 0; }
  .entry-link {
    display: block;
    padding: 16px 14px;
    margin: 0 -14px;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
    transition: background 180ms ease, transform 180ms ease;
  }
  .entry-link:hover {
    background: rgba(216, 166, 87, 0.04);
    transform: translateX(2px);
  }
  .entry-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 4px;
  }
  .entry-title {
    font-family: var(--font-sans);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--foreground);
    margin: 0 0 4px;
  }
  .entry-desc {
    font-family: var(--font-serif);
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted-foreground);
    margin: 0;
  }
</style>
