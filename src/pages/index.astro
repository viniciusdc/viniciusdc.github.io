---
import Layout from "@/layouts/Layout.astro";

const latestNotes = [
  {
    href: "/notes/nvidia-runtimeclass-gpu-workloads/",
    date: "2026-04-11",
    tag: "debugging",
    title: "Injecting NVIDIA runtimeClass into GPU workloads",
    desc: "Device plugin, nvidia-ctk, containerd config, RuntimeClass, and Kyverno policy boundaries.",
  },
  {
    href: "/notes/traefik-tls-options-scanner-expectations/",
    date: "2026-04-07",
    tag: "security",
    title: "Traefik TLS options and scanner expectations",
    desc: "Ingress behavior, TLS 1.2 cipher policy, redirects, and certificate chain presentation.",
  },
  {
    href: "/architecture/keycloak-state-recreation/",
    date: "2026-03-28",
    tag: "architecture",
    title: "Keycloak state recreation without surprises",
    desc: "Dependency ordering, dry-run planning, conflict handling, and import/export boundaries.",
  },
];
---

<Layout title="Vinicius Cerutti — Field Notes">
  <div class="w-[min(1120px,calc(100%-44px))] mx-auto">
    <main>

      <!-- Hero -->
      <header class="hero-grid items-center border-b border-border pb-[clamp(56px,8vw,86px)] pt-[clamp(72px,9vw,116px)]">
        <div>
          <p class="eyebrow">Kubernetes · platform engineering · systems work</p>

          <h1 class="hero-title font-bold leading-[0.96] text-foreground">
            Infrastructure that needs to keep working.
          </h1>

          <p class="hero-copy text-muted-foreground">
            Kubernetes, identity, TLS, GPU runtimes, operators, and the architecture
            decisions I want to remember. Written down before I forget.
          </p>

          <div class="flex flex-wrap gap-3 mt-8">
            <a href="/notes/" class="action-primary">read notes →</a>
            <a href="/architecture/" class="action">architecture</a>
            <a href="/projects/" class="action">projects</a>
          </div>
        </div>

        <aside class="now-card" aria-label="Currently focused on">
          <p class="now-label">now</p>
          <p class="now-text">
            Building platform automation with Go and GitOps.
            Debugging TLS trust chains, ingress, and GPU runtime wiring on bare-metal K3s.
            Writing notes for the things that shouldn't need to be figured out twice.
          </p>
        </aside>
      </header>

      <!-- Latest -->
      <section class="section-pad" aria-labelledby="latest-title">
        <h2 class="section-kicker" id="latest-title">recent</h2>

        <div class="latest-layout">
          <a href="/notes/k3s-tls-trust-errors/" class="featured-note card-link">
            <div class="meta-label">2026-04-27 · field note</div>
            <div>
              <h3 class="featured-title text-foreground">K3s TLS trust errors from worker nodes</h3>
              <p class="text-muted-foreground mb-0">
                Why kubectl fails against the API server when kubeconfig ownership, CA data, or KUBECONFIG env drift.
              </p>
            </div>
          </a>

          <div class="note-list">
            {latestNotes.map(({ href, date, tag, title, desc }) => (
              <a href={href} class="note-row block py-5 transition-all duration-150">
                <div class="meta-label mb-2">{date} · {tag}</div>
                <h3 class="text-[19px] font-semibold leading-snug tracking-tight text-foreground mb-1.5">{title}</h3>
                <p class="text-muted-foreground text-sm mb-0">{desc}</p>
              </a>
            ))}
          </div>
        </div>
      </section>

    </main>
  </div>
</Layout>

<style>
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--faint);
    letter-spacing: 0.04em;
    margin: 0 0 28px;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: clamp(42px, 7vw, 88px);
    min-height: calc(100vh - 86px);
  }
  .hero-title {
    font-size: clamp(48px, 7.5vw, 90px);
    letter-spacing: -0.07em;
    max-width: 820px;
    margin: 0 0 26px;
  }
  .hero-copy {
    max-width: 680px;
    font-size: clamp(17px, 1.8vw, 20px);
    line-height: 1.62;
    margin: 0;
  }

  .action, .action-primary {
    display: inline-flex; align-items: center; gap: 8px;
    border: 1px solid var(--border-strong); border-radius: 999px;
    padding: 8px 14px; font-family: var(--font-mono); font-size: 12px;
    transition: border-color 160ms ease, color 160ms ease, background 160ms ease;
    color: var(--foreground);
  }
  .action:hover { color: var(--link); border-color: rgba(155,209,223,0.42); }
  .action-primary {
    color: #f1d39b;
    border-color: rgba(216,166,87,0.38);
    background: var(--accent-soft);
  }

  .now-card {
    border-left: 1px solid var(--border);
    padding-left: 26px;
    align-self: center;
  }
  .now-label {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin: 0 0 14px;
  }
  .now-text {
    color: var(--muted-foreground);
    font-size: 14px;
    line-height: 1.7;
    margin: 0;
  }

  .section-pad { padding: clamp(56px, 7vw, 80px) 0; }
  .section-kicker {
    font-family: var(--font-mono); font-size: 12px; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.1em;
    color: var(--accent); margin: 0 0 28px;
  }

  .meta-label {
    color: var(--faint); font-family: var(--font-mono);
    font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase;
  }

  .card-link {
    display: flex; flex-direction: column; justify-content: space-between;
    border: 1px solid var(--border); border-radius: var(--radius);
    background: rgba(18,21,27,0.78);
    transition: border-color 160ms ease, background 160ms ease;
    text-decoration: none;
  }
  .card-link:hover {
    border-color: var(--border-strong);
    background: var(--surface-raised);
  }

  .latest-layout {
    display: grid;
    grid-template-columns: minmax(0,1.05fr) minmax(300px,0.95fr);
    gap: 16px;
    align-items: start;
  }
  .featured-note {
    padding: 28px;
    background: linear-gradient(135deg,rgba(216,166,87,0.07),transparent 55%), rgba(18,21,27,0.78);
    justify-content: flex-start;
    gap: 0;
  }
  .featured-title {
    font-size: clamp(26px, 3vw, 38px); font-weight: 650;
    line-height: 1.08; letter-spacing: -0.045em;
    margin: 32px 0 12px; max-width: 600px;
  }
  .note-row { border-radius: 12px; }
  .note-row:hover { padding-left: 14px; padding-right: 14px; background: var(--surface-raised); }

  @media (max-width: 980px) {
    .hero-grid { grid-template-columns: 1fr; min-height: auto; }
    .now-card { border-left: none; border-top: 1px solid var(--border); padding-left: 0; padding-top: 24px; }
  }
  @media (max-width: 780px) {
    .latest-layout { grid-template-columns: 1fr; }
  }
</style>
