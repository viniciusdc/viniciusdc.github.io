---
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "A notebook of platform-engineering things, by Vinicius Cerutti." } = Astro.props;
const pathname = Astro.url.pathname;

const nav = [
  { href: "/writing/", label: "writing" },
  { href: "/projects/", label: "projects" },
  { href: "/about/", label: "about" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <nav
      class="sticky top-0 z-10 w-full border-b border-border text-[14px]"
      style="background: rgba(26,22,18,0.82); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px); color: var(--muted-foreground);"
      aria-label="Primary navigation"
    >
      <div class="w-[min(960px,calc(100%-44px))] mx-auto flex justify-between items-center gap-6 py-5">
        <a href="/" class="brand">
          vinicius<span class="brand-dev">.dev</span>
        </a>
        <div class="flex gap-6 flex-wrap" style="font-family: var(--font-mono); font-size: 13px;">
          {nav.map(({ href, label }) => (
            <a
              href={href}
              class="nav-link transition-colors duration-150"
              aria-current={pathname.startsWith(href) ? "page" : undefined}
            >
              {label}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <slot />

    <footer class="w-full border-t border-border mt-auto">
      <div class="w-[min(720px,calc(100%-44px))] mx-auto flex flex-wrap justify-between gap-3 py-10 text-[13px]"
           style="color: var(--faint); font-family: var(--font-serif); font-style: italic;">
        <span>— vinicius cerutti</span>
        <span>made by hand · sometimes late at night</span>
      </div>
    </footer>
  </body>
</html>

<style>
  .brand {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 19px;
    color: var(--foreground);
    letter-spacing: -0.005em;
  }
  .brand-dev {
    color: var(--accent);
    font-style: italic;
  }
  .nav-link {
    color: var(--muted-foreground);
  }
  .nav-link:hover {
    color: var(--foreground);
  }
  /* Active nav link via aria-current */
  nav a[aria-current="page"] {
    color: var(--accent);
  }
</style>
