---
import "@/styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Platform engineering field notes by Vinicius Cerutti" } = Astro.props;
const pathname = Astro.url.pathname;

const nav = [
  { href: "/writing/", label: "writing" },
  { href: "/projects/", label: "projects" },
  { href: "/about/", label: "about" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <!-- Nav is full-width so sticky works against the viewport, inner div constrains content -->
    <nav
      class="sticky top-0 z-10 w-full border-b border-border font-mono text-[13px] text-muted-foreground"
      style="background: rgba(12,14,18,0.82); backdrop-filter: blur(18px); -webkit-backdrop-filter: blur(18px);"
      aria-label="Primary navigation"
    >
      <div class="w-[min(1120px,calc(100%-44px))] mx-auto flex justify-between items-center gap-6 py-6">
        <a href="/" class="font-bold text-foreground" style="letter-spacing: -0.02em;">
          vinicius<span style="color: var(--accent);">.dev</span>
        </a>
        <div class="flex gap-6 flex-wrap">
          {nav.map(({ href, label }) => (
            <a
              href={href}
              class="transition-colors duration-150 hover:text-foreground"
              aria-current={pathname.startsWith(href) ? "page" : undefined}
            >
              {label}
            </a>
          ))}
        </div>
      </div>
    </nav>

    <slot />

    <footer class="w-full border-t border-border mt-auto">
      <div class="w-[min(1120px,calc(100%-44px))] mx-auto flex justify-between gap-5 py-11 font-mono text-[12px]" style="color: var(--faint);">
        <span>Vinicius Cerutti</span>
        <span>field notes · architecture · systems debugging</span>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Active nav link via aria-current */
  nav a[aria-current="page"] {
    color: var(--accent);
  }
</style>
